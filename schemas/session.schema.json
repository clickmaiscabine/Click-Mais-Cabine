{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clickmaiscabine.local/schemas/session.schema.json",
  "title": "Click Mais Runtime Session v1.2.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "external_session_key",
    "channel",
    "current_state",
    "state_version",
    "status",
    "context",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "external_session_key": {
      "type": "string",
      "minLength": 1
    },
    "channel": {
      "type": "string",
      "minLength": 1
    },
    "current_state": {
      "type": "string",
      "minLength": 1
    },
    "state_version": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "enum": [
        "active",
        "paused",
        "closed"
      ]
    },
    "context": {
      "type": "object",
      "additionalProperties": true
    },
    "contact_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "active_customer_event_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
