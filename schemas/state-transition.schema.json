{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clickmaiscabine.local/schemas/state-transition.schema.json",
  "title": "Click Mais State Transition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "session_id",
    "to_state",
    "actor_type",
    "metadata",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "session_id": {
      "type": "string",
      "format": "uuid"
    },
    "trigger_event_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "from_state": {
      "type": [
        "string",
        "null"
      ]
    },
    "to_state": {
      "type": "string",
      "minLength": 1
    },
    "reason_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "actor_type": {
      "type": "string",
      "minLength": 1
    },
    "actor_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
