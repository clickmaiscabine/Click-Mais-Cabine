{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clickmaiscabine.local/schemas/agent-run.schema.json",
  "title": "Click Mais Agent Run Audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "agent_name",
    "purpose",
    "status",
    "metadata",
    "started_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "agent_name": {
      "type": "string",
      "minLength": 1
    },
    "model_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "artifact_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "input_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "output_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
