{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clickmaiscabine.local/schemas/customer-event.schema.json",
  "title": "Click Mais Customer Event v1.2.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "contact_id",
    "commercial_stage",
    "operational_stage",
    "stage_version",
    "status",
    "metadata",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "contact_id": {
      "type": "string",
      "format": "uuid"
    },
    "external_event_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "primary_touchpoint_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "event_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "event_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "event_start_time": {
      "type": [
        "string",
        "null"
      ]
    },
    "city": {
      "type": [
        "string",
        "null"
      ]
    },
    "district": {
      "type": [
        "string",
        "null"
      ]
    },
    "venue_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "venue_address": {
      "type": [
        "string",
        "null"
      ]
    },
    "locality_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "commercial_stage": {
      "enum": [
        "PRE_QUOTE",
        "ORCAMENTO",
        "RESPOSTA",
        "FAC_DUVIDAS",
        "NEGOCIACAO",
        "FECHAMENTO",
        "GANHO",
        "PERDIDO"
      ]
    },
    "operational_stage": {
      "enum": [
        "NOT_STARTED",
        "PRE_EVENT",
        "EVENT_READY",
        "EVENT_DAY",
        "POST_EVENT",
        "COMPLETED",
        "SUSPENDED",
        "CANCELLED"
      ]
    },
    "stage_version": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "enum": [
        "active",
        "paused",
        "closed"
      ]
    },
    "qualified_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "won_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "lost_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "closed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "deleted_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "lifecycle_stage": {
      "type": [
        "string",
        "null"
      ],
      "description": "LEGACY v1.1 compatibility field; not canonical for new workflows."
    }
  }
}
