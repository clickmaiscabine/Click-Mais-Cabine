{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clickmaiscabine.local/schemas/workflow-run.schema.json",
  "title": "Click Mais Workflow Run Audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "workflow_id",
    "status",
    "metadata",
    "started_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "input_event_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "workflow_id": {
      "type": "string",
      "minLength": 1
    },
    "workflow_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "n8n_execution_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
