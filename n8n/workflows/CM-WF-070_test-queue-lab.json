    {
      "id": "cmc-fail-handler-img-v1",
      "name": "Supabase — reagendar envio falho TEST",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1510,
        700
      ],
      "parameters": {
        "method": "PATCH",
        "url": "=https://tsuuqcodmyuwqxfwevps.supabase.co/rest/v1/cmc_test_outbound_queue?id=eq.{{ $(\"Supabase — reivindicar próximo envio TEST\").item.json.id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ (()=>{\n// Meta has no client idempotency key for message sends. Unknown outcomes require review.\nfunction dispatchFailurePatch(input, claimed, now) {\n  const error=input?.error??input??{};\n  const status=Number(error.httpCode??error.statusCode??error.response?.statusCode??error.response?.status);\n  const meta=error.response?.body?.error??error.cause?.error??error.error??error;\n  const code=Number(meta.code);\n  const message=String(error.message??meta.message??'whatsapp_send_failed').slice(0,850);\n  const acknowledged=Boolean(input?.messages?.[0]?.id);\n  const rejected=!acknowledged&&status>=400&&status<500&&status!==408;\n  const transient=rejected&&(status===429||[4,17,32,613,80007,130429,131048,131056].includes(code));\n  const canRetry=transient&&claimed.attempts<claimed.max_attempts;\n  return {status:'failed',last_error:(rejected?'META_SEND_REJECTED:':'UNCERTAIN_DISPATCH_REQUIRES_HUMAN:')+message,\n    attempts:canRetry?claimed.attempts:claimed.max_attempts,\n    next_attempt_at:canRetry?new Date(new Date(now).getTime()+60000).toISOString():null,updated_at:now};\n}\n\nreturn dispatchFailurePatch($json,$('Supabase — reivindicar próximo envio TEST').item.json,$now.toISO());\n})() }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      }
    }
